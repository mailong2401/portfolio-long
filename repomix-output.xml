                <IconButton 
              icon={<ArrowBigRight size={16}/>}
                  onClick={handleSendMessage}
                  disabled={!inputMessage.trim()}
              variant="primary"
              size="sm"
                  className="flex-shrink-0 h-11 w-11 rounded-xl"
            />

              </div>
            </div>
          </div>
        </div>
      )}
    </>
  )
}
