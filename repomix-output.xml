        <ScrollAnimation direction="up" delay={0.8} duration={0.6}>
          <TechStack />
        </ScrollAnimation>

        {/* Passion & Sở thích */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          <ScrollAnimation direction="left" delay={0.9} duration={0.6}>
            <PassionCard
